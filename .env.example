# Flask
SECRET_KEY=change-this-secret-key

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: custom Google Sheet tab names
SHEET_USERS=Users
SHEET_PROGRESS=Progress
SHEET_STUDENT_NOTES=StudentNotes
SHEET_DAY_NOTES=DayNotes
SHEET_DAY_FILES=DayFiles
SHEET_DAY_BUTTONS=DayButtons

# Optional: default admin login
ADMIN_EMAIL=admin@bst.local
ADMIN_PASSWORD=admin123

# Optional: default project ZIP button link
FULL_PROJECT_ZIP_URL=https://drive.google.com/your-project-zip-link

# Optional: direct upload to Google Drive from admin page
# Share this Drive folder with the service account email as Editor.
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
